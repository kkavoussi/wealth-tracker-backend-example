# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER commit .env to GitHub — it is blocked by .gitignore
# ============================================================

# ------ Supabase ------
# Found in: Supabase Dashboard → Project Settings → API Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Found in: Supabase Dashboard → Connect button (top bar) → Connection string
SUPABASE_DB_PASSWORD=your-database-password-here

# ------ Plaid ------
# Same values as your existing .env in the Python Scripts project
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-production-secret
PLAID_SANDBOX_SECRET=your-plaid-sandbox-secret
PLAID_ENV=production

# ------ Anthropic ------
ANTHROPIC_API_KEY=your-anthropic-api-key

# ------ App ------
APP_ENV=development
SECRET_KEY=generate-a-random-string-here
